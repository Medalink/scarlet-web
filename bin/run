#!/bin/sh
# Runs a command in this checkout's tools container (see DEV.md): bin/run php artisan about
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
slug=$(basename "$root" | tr 'A-Z' 'a-z' | sed -E -e 's/^scarlet-(api|web)(-|$)//' -e 's/[^a-z0-9]+/-/g' -e 's/^-//' -e 's/-$//')
[ -n "$slug" ] || slug=main
tty=
if [ -t 0 ] && [ -t 1 ]; then tty=-t; fi
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
# shellcheck disable=SC2086
exec "${WSLC:-/c/Program Files/WSL/wslc.exe}" exec $tty -w "${SCARLET_WORKDIR:-/app}" "scarlet-web-wt-$slug" "$@"
