#!/bin/bash
# Builds, ships and rolls out scarletweb.io. Run it from medaviper (Git Bash) or from medaware.
#
#   bin/deploy [ref]            build ref (a sha, branch or tag; default main) on the build host, load the image on the
#                               droplet, migrate, start the release beside the running one and move visitors to it with
#                               an nginx reload: no failed request. A failed health check leaves the old release serving.
#   bin/deploy rollback         move visitors back to the release before the current one, the same way (code only)
#   bin/deploy status           the containers, the release and the zone settings
#   bin/deploy logs [service]   follow the logs (web, app-blue, app-green, horizon-a, horizon-b, horizon-c, schedule, postgres, redis, registry)
#   bin/deploy backup           a backup now: dump, encrypt, copy to R2 (starts the nightly unit; exits 1 when it fails)
#   bin/deploy backups          the newest local and R2 copies with their ages; exits 1 when stale or the last run failed
#   bin/deploy r2               write the R2 credentials from the secrets folder to /etc/scarlet-web/r2.env on the app droplet and
#                               the database host (run before `server` and `db-server`)
#   bin/deploy cache-rules      write Cloudflare's Cache Rules for the public API, the public pages and the map manifest
#   bin/deploy maps <folder>    copy map tiles (a folder with manifest.json) to the droplet's disk, outside the image
#   bin/deploy bootstrap [ref]  first install: server, DNS, certificate, release, strict TLS, origin pulls
#   bin/deploy server | tls | dns | strict | aop     the steps of bootstrap, each safe to run again
#   bin/deploy ssh [command]    a shell on the droplet
#   bin/deploy db-server        install the database host (deploy/server-setup-db.sh)
#   bin/deploy db-move [rollback|abort|retire|finish]   move the database to the database host, or back; see deploy/db-move.sh
#   bin/deploy db status        the database host: role, archiver, last pgBackRest backup, volume, replication
#   bin/deploy db upgrade       push this checkout's deploy/ to the database host and recreate Postgres if its pin changed
#
# Settings (environment): SCARLET_SECRETS (folder with ops_ed25519, cloudflare-token), DEPLOY_HOST (default
# scarlet-web, its tailnet name), DEPLOY_BUILD_HOST (default medaware; `local` builds on this machine),
# DEPLOY_REPO (default the GitHub repository), DEPLOY_DB_HOST (default scarlet-db), DEPLOY_PGBR_NAME (the pgBackRest folder in
# the bucket and the prefix of its passphrase file in the secrets folder; default pgbackrest).
set -euo pipefail

here=$(cd "$(dirname "$0")/.." && pwd)
case "$(uname -s)" in
  MINGW* | MSYS*) default_secrets=E:/Dev/secrets/scarlet-web ;;
  *) default_secrets=$HOME/.config/scarlet-web ;;
esac
secrets=${SCARLET_SECRETS:-$default_secrets}
host=${DEPLOY_HOST:-scarlet-web}
build_host=${DEPLOY_BUILD_HOST:-medaware}
db_host=${DEPLOY_DB_HOST:-scarlet-db}
pgbr_name=${DEPLOY_PGBR_NAME:-pgbackrest}
repo=${DEPLOY_REPO:-https://github.com/Medalink/scarlet-web.git}
cf="node $here/deploy/cloudflare.mjs"
export SCARLET_SECRETS=$secrets

ssh_opts=(-i "$secrets/ops_ed25519" -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30)
srv() { ssh "${ssh_opts[@]}" "ops@$host" "$@"; }
dsrv() { ssh "${ssh_opts[@]}" "ops@$db_host" "$@"; }
on_build() {
  if [ "$build_host" = local ]; then bash -c "$1"; else ssh -o ServerAliveInterval=30 "$build_host" "$1"; fi
}
# Where the build host keeps its clone: the same place build.sh uses.
build_src='$(echo /data/$(id -un))/scratch/scarlet-web-build/src'

push_deploy_folder() {
  local t0
  t0=$(now)
  on_build "tar -C $build_src -cf - deploy" | srv 'rm -rf /srv/scarlet-web/deploy.new && mkdir -p /srv/scarlet-web/deploy.new && tar -C /srv/scarlet-web/deploy.new --strip-components=1 --no-same-owner -xf - && rm -rf /srv/scarlet-web/deploy && mv /srv/scarlet-web/deploy.new /srv/scarlet-web/deploy'
  echo "phase deploy-folder $(span "$t0" "$(now)")" >> "$timing/ship.out"
}

now() { date +%s.%N; }
span() { awk -v a="$1" -v b="$2" 'BEGIN { printf "%.1f", b - a }'; }

timing=
lap_at=
laps=()
lap() {
  local t
  t=$(now)
  laps+=("$1|$(span "$lap_at" "$t")")
  lap_at=$t
}
phase_of() { sed -n "s/^phase $2 //p" "$timing/$1" 2>/dev/null | tail -n 1; }
row() { printf '  %-26s %8s s\n' "$1" "${2:-n/a}"; }
report() {
  [ -n "$timing" ] || return 0
  local l name secs
  echo "deploy: time per phase"
  for l in "${laps[@]}"; do
    name=${l%%|*}
    secs=${l##*|}
    row "$name" "$secs"
    case $name in
      build)
        row "  slot wait" "$(phase_of build.out slot-wait)"
        row "  docker build" "$(phase_of build.out docker-build)"
        ;;
      "image transfer")
        row "  wait for the tunnel" "$(phase_of ship.out tunnel-wait)"
        row "  docker push" "$(phase_of ship.out push)"
        row "  deploy folder (alongside)" "$(phase_of ship.out deploy-folder)"
        ;;
      rollout)
        row "  pull and start databases" "$(phase_of rollout.out compose-up)"
        row "  migrate" "$(phase_of rollout.out migrate)"
        row "  start and health check" "$(phase_of rollout.out start-health)"
        row "  switch" "$(phase_of rollout.out switch)"
        row "    assets, nginx" "$(phase_of rollout.out switch-nginx)"
        row "    stop old php-fpm" "$(phase_of rollout.out stop-old-app)"
        row "    horizon, schedule" "$(phase_of rollout.out start-workers)"
        row "  prune images" "$(phase_of rollout.out prune)"
        ;;
    esac
  done
  row total "$(span "$deploy_at" "$(now)")"
  [ ! -s "$timing/sent_kb" ] || printf '  new layers stored on the droplet: %s MB\n' "$(awk '{ printf "%.1f", $1 / 1024 }' "$timing/sent_kb")"
  rm -rf "$timing"
}

build() {
  local ref=$1
  on_build "bash -s -- '$repo' '$ref'" < "$here/deploy/build.sh" | tee /dev/stderr | tee "$timing/build.out" | sed -n 's/^built //p' | tail -n 1
}

ship_whole_image() {
  local tag=$1
  { on_build "sudo -n docker save scarlet-web-app:$tag | zstd -T2 -3"; now > "$timing/sent"; } | srv 'zstd -d | docker load'
}

registry_port=5077
tunnel_port=15077
registry_url=127.0.0.1:$registry_port
registry_data_kb='docker exec scarlet-web-registry-1 du -sk /var/lib/registry | cut -f1'

open_registry_path() {
  local kb
  kb=$(srv "curl -sf -o /dev/null http://127.0.0.1:$registry_port/v2/ || /srv/scarlet-web/deploy/dc up -d --no-deps --wait registry >&2; $registry_data_kb") || return 1
  echo "$kb" > "$timing/before_kb"
  exec ssh "${ssh_opts[@]}" -o ExitOnForwardFailure=yes -N -L "127.0.0.1:$tunnel_port:127.0.0.1:$registry_port" "ops@$host"
}

registry_job=
ship_new_layers() {
  local tag=$1 after ready= rc=0 at=$registry_url t0 t1
  t0=$(now)
  for _ in $(seq 1 150); do
    if [ -s "$timing/before_kb" ] && curl -sf --max-time 2 -o /dev/null "http://127.0.0.1:$tunnel_port/v2/"; then ready=1; break; fi
    kill -0 "$registry_job" 2>/dev/null || break
    sleep 0.1
  done
  [ -n "$ready" ] || return 1
  t1=$(now)
  echo "phase tunnel-wait $(span "$t0" "$t1")" >> "$timing/ship.out"
  [ "$build_host" = local ] && at=127.0.0.1:$tunnel_port
  local push="sudo -n docker tag scarlet-web-app:$tag $at/scarlet-web-app:$tag && sudo -n docker push -q $at/scarlet-web-app:$tag >/dev/null; rc=$?; sudo -n docker rmi $at/scarlet-web-app:$tag >/dev/null 2>&1; echo pushed:$rc"
  local pusher
  if [ "$build_host" = local ]; then
    bash -c "$push" > "$timing/push.out" &
  else
    ssh -o ServerAliveInterval=30 -o ExitOnForwardFailure=yes -R "127.0.0.1:$registry_port:127.0.0.1:$tunnel_port" "$build_host" "$push" > "$timing/push.out" &
  fi
  pusher=$!
  until grep -q '^pushed:' "$timing/push.out" 2>/dev/null || ! kill -0 "$pusher" 2>/dev/null; do sleep 0.1; done
  grep -qx 'pushed:0' "$timing/push.out" 2>/dev/null || rc=1
  kill "$pusher" "$registry_job" 2>/dev/null || true
  [ "$rc" = 0 ] || return 1
  now > "$timing/sent"
  echo "phase push $(span "$t1" "$(cat "$timing/sent")")" >> "$timing/ship.out"
  after=$(srv "docker pull -q $registry_url/scarlet-web-app:$tag >/dev/null && docker tag $registry_url/scarlet-web-app:$tag scarlet-web-app:$tag && docker rmi $registry_url/scarlet-web-app:$tag >/dev/null && $registry_data_kb") || return 1
  echo $((after - $(cat "$timing/before_kb"))) > "$timing/sent_kb"
}

ship_images() {
  local tag=$1
  if [ "${DEPLOY_TRANSPORT:-registry}" = registry ] && ship_new_layers "$tag"; then return 0; fi
  echo "deploy: sending the whole image"
  ship_whole_image "$tag"
}

# One deploy at a time, build included: every deploy builds in the same clone on the build host and unpacks into the
# same folders on the server. The lock is a folder on the server; one older than 40 minutes is a crashed deploy's.
lock=/srv/scarlet-web/state/deploy.lock
take_lock() {
  until srv "mkdir -p /srv/scarlet-web/state && mkdir $lock 2>/dev/null && date +%s > $lock/at"; do
    srv "[ -f $lock/at ] && [ \$(( \$(date +%s) - \$(cat $lock/at) )) -gt 2400 ] && rm -rf $lock" || true
    echo "deploy: another deploy is running; waiting for it"
    sleep 3
  done
  trap 'srv "rm -rf '"$lock"'"; kill "$registry_job" 2>/dev/null || true; report' EXIT
}

release() {
  local ref=${1:-main} sha
  timing=$(mktemp -d)
  deploy_at=$(now)
  lap_at=$deploy_at
  take_lock
  lap "lock wait"
  if [ "${DEPLOY_TRANSPORT:-registry}" = registry ]; then
    open_registry_path &
    registry_job=$!
  fi
  sha=$(build "$ref")
  [ -n "$sha" ] || { echo "deploy: the build gave no sha" >&2; exit 1; }
  echo "deploy: built $sha"
  lap build
  push_deploy_folder &
  local folder_job=$!
  ship_images "${sha:0:12}"
  wait "$folder_job"
  local end
  end=$(now)
  laps+=("image transfer|$(span "$lap_at" "$(cat "$timing/sent")")" "load or pull on droplet|$(span "$(cat "$timing/sent")" "$end")")
  lap_at=$end
  srv "/srv/scarlet-web/deploy/rollout.sh ${sha:0:12}" 2>&1 | tee "$timing/rollout.out"
  lap rollout
  echo "deploy: $sha is live"
}

step_server() {
  srv 'sudo install -d -o ops -g ops -m 750 /srv/scarlet-web'
  # The first deploy folder comes from the checkout this script runs in; later releases bring their own.
  tar -C "$here" -cf - deploy | srv 'tar -C /srv/scarlet-web --no-same-owner -xf -'
  srv 'sh /srv/scarlet-web/deploy/server-setup.sh'
}

step_tls() {
  local tmp
  tmp=$(mktemp -d)
  srv 'cat /srv/scarlet-web/tls/origin.csr' > "$tmp/origin.csr"
  $cf origin-cert "$tmp/origin.csr" "$tmp/origin.pem"
  srv 'cat > /srv/scarlet-web/tls/origin.pem && chmod 644 /srv/scarlet-web/tls/origin.pem' < "$tmp/origin.pem"
  rm -rf "$tmp"
}

droplet_address() { srv "ip -$1 route get $2 | grep -o 'src [^ ]*' | cut -d' ' -f2"; }

step_dns() {
  $cf dns "$(droplet_address 4 1.1.1.1)" "$(droplet_address 6 2606:4700:4700::1111)"
  $cf settings
}

step_aop() {
  $cf aop on
  srv 'cp /srv/scarlet-web/deploy/nginx/aop-on.conf /srv/scarlet-web/state/aop.conf && /srv/scarlet-web/deploy/dc exec -T web nginx -c /etc/nginx/scarlet/nginx.conf -t && /srv/scarlet-web/deploy/dc exec -T web nginx -c /etc/nginx/scarlet/nginx.conf -s reload'
}

# The R2 credentials go from the secrets folder to /etc/scarlet-web/r2.env (root:root, mode 600) as rclone settings.
# The values are read inside this command and pass through the ssh pipe only: no argument, log or file here holds them.
step_r2() {
  local f run=${1:-srv}
  for f in r2-access-key-id r2-secret-access-key r2-endpoint; do
    [ -s "$secrets/$f" ] || { echo "deploy: $secrets/$f is missing" >&2; exit 1; }
  done
  $run 'sudo install -d -m 755 /etc/scarlet-web'
  {
    printf 'RCLONE_CONFIG_R2_TYPE=s3\nRCLONE_CONFIG_R2_PROVIDER=Cloudflare\n'
    printf 'R2_BUCKET=%s\n' "${R2_BUCKET:-scarlet-web-backups}"
    printf 'RCLONE_CONFIG_R2_ACCESS_KEY_ID=%s\n' "$(tr -d '\r\n' < "$secrets/r2-access-key-id")"
    printf 'RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=%s\n' "$(tr -d '\r\n' < "$secrets/r2-secret-access-key")"
    printf 'RCLONE_CONFIG_R2_ENDPOINT=%s\n' "$(tr -d '\r\n' < "$secrets/r2-endpoint")"
  } | $run 'sudo sh -c "umask 077 && cat > /etc/scarlet-web/r2.env.new && chown root:root /etc/scarlet-web/r2.env.new && mv /etc/scarlet-web/r2.env.new /etc/scarlet-web/r2.env"'
  echo "deploy: wrote /etc/scarlet-web/r2.env on $([ "$run" = srv ] && echo the app droplet || echo the database host) (root:root, mode 600)"
}

# The nightly unit's last result, then the newest local and R2 copies with their ages. Exits 1 when the last run
# failed, R2 cannot be read or its newest daily copy is more than 26 hours old. The unit runs where the database is; with the
# database on its own host the report adds the WAL archive: it also fails when the last archived segment is older than 5
# minutes, when the archiver's last attempt failed or when pgBackRest has no backup (deploy/db-host.sh status).
backups_report() {
  local result rc=0 run=srv base=/srv/scarlet-web
  if db_moved; then run=dsrv base=/srv/scarlet-db; fi
  result=$($run 'systemctl show -p Result --value scarlet-backup.service')
  echo "backup unit on $([ "$run" = srv ] && echo "$host" || echo "$db_host"): last result $result; $($run 'systemctl list-timers scarlet-backup.timer --no-pager | sed -n 2p' | awk '{print "next run", $1, $2, $3}')"
  [ "$result" = success ] || rc=1
  $run "sudo sh -c \"set -a; . /etc/scarlet-web/r2.env; set +a; export SCARLET_BASE=$base; exec $base/deploy/backup.sh status\"" || rc=1
  if [ "$run" = dsrv ]; then dsrv /srv/scarlet-db/deploy/db-host.sh status || rc=1; fi
  return "$rc"
}

. "$here/deploy/db-move.sh"

case "${1:-release}" in
  release) release "${2:-main}" ;;
  rollback) srv '/srv/scarlet-web/deploy/rollout.sh --rollback' ;;
  status)
    srv '/srv/scarlet-web/deploy/dc ps; cat /srv/scarlet-web/release.env'
    $cf status
    db_moved && db_status
    backups_report
    ;;
  logs) srv "/srv/scarlet-web/deploy/dc logs --tail 100 -f ${2:-}" ;;
  backup)
    run=srv
    ! db_moved || run=dsrv
    $run 'sudo systemctl start scarlet-backup.service; rc=$?; journalctl -u scarlet-backup.service -n 12 --no-pager -o cat; exit $rc'
    ;;
  backups) backups_report ;;
  r2)
    step_r2 srv
    ! db_moved || step_r2 dsrv
    ;;
  db-server) db_server ;;
  db-move)
    case "${2:-move}" in
      move) db_move ;;
      rollback) db_rollback ;;
      abort) take_lock; db_abort ;;
      retire) db_retire ;;
      finish) take_lock; db_finish "$(db_private_address)" ;;
      *) echo "deploy: db-move [rollback|abort|retire|finish]" >&2; exit 2 ;;
    esac
    ;;
  db)
    case "${2:-status}" in
      status) db_status ;;
      upgrade) db_upgrade ;;
      *) echo "deploy: db [status|upgrade]" >&2; exit 2 ;;
    esac
    ;;
  maps)
    [ -f "${2:?folder with manifest.json}/manifest.json" ] || { echo "deploy: no manifest.json in $2" >&2; exit 1; }
    tar -C "$2" -cf - . | srv 'mkdir -p /srv/scarlet-web/maps && tar -C /srv/scarlet-web/maps --no-same-owner -xf - && chmod -R a+rX /srv/scarlet-web/maps'
    echo "deploy: maps copied to /srv/scarlet-web/maps"
    ;;
  server) step_server ;;
  tls) step_tls ;;
  dns) step_dns ;;
  strict) $cf ssl strict ;;
  cache-rules) $cf cache-rules ;;
  aop) step_aop ;;
  bootstrap)
    step_server
    step_dns
    step_tls
    release "${2:-main}"
    srv "curl -sk --resolve scarletweb.io:443:127.0.0.1 -o /dev/null -w 'origin certificate serves: %{http_code}\n' https://scarletweb.io/up"
    curl -s -o /dev/null -w 'through Cloudflare (ssl full): %{http_code}\n' https://scarletweb.io/up
    $cf ssl strict
    sleep 5
    curl -s -o /dev/null -w 'through Cloudflare (ssl strict): %{http_code}\n' https://scarletweb.io/up
    step_aop
    sleep 5
    curl -s -o /dev/null -w 'through Cloudflare (origin pulls): %{http_code}\n' https://scarletweb.io/up
    ;;
  ssh) shift; srv "$@" ;;
  help | -h | --help) sed -n '2,26p' "$0" ;;
  *) release "$1" ;;
esac
