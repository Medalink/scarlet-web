#!/bin/bash
# Builds, ships and rolls out scarletweb.io. Run it from medaviper (Git Bash) or from medaware.
#
#   bin/deploy [ref]            build ref (a sha, branch or tag; default main) on the build host, load the image on the
#                               droplet, migrate, start the release beside the running one and move visitors to it with
#                               an nginx reload: no failed request. A failed health check leaves the old release serving.
#   bin/deploy rollback         move visitors back to the release before the current one, the same way (code only)
#   bin/deploy status           the containers, the release and the zone settings
#   bin/deploy logs [service]   follow the logs (web, app-blue, app-green, horizon-a, horizon-b, horizon-c, schedule, postgres, redis, registry)
#   bin/deploy backup           a backup now: dump, encrypt, copy to R2 (starts the nightly unit; exits 1 when it fails)
#   bin/deploy backups          the newest local and R2 copies with their ages; exits 1 when stale or the last run failed
#   bin/deploy r2               write the R2 credentials from the secrets folder to /etc/scarlet-web/r2.env on the app droplet and
#                               the database host (run before `server` and `db-server`)
#   bin/deploy cache-rules      write Cloudflare's Cache Rules for the public API, the public pages and the map manifest
#   bin/deploy maps <folder>    copy map tiles (a folder with manifest.json) to the droplet's disk, outside the image
#   bin/deploy bootstrap [ref]  first install: server, DNS, certificate, release, strict TLS, origin pulls
#   bin/deploy server | tls | dns | strict | aop     the steps of bootstrap, each safe to run again
#   bin/deploy ring-key <file>  let the flow ring deploy: install scripts/deploy/ring-entry.sh on the droplet and allow the public
#                               key in <file> to run it and nothing else (docs/HOSTING.md, "Deploy ring")
#   bin/deploy ssh [command]    a shell on the droplet
#   bin/deploy db-server        install the database host (deploy/server-setup-db.sh)
#   bin/deploy db-move [rollback|abort|retire|finish]   move the database to the database host, or back; see deploy/db-move.sh
#   bin/deploy db status        the database host: role, archiver, last pgBackRest backup, volume, replication
#   bin/deploy db upgrade       push this checkout's deploy/ to the database host and recreate Postgres if its pin changed
#   bin/deploy hosts [prepare]  list deploy/hosts.tsv (a host, its roles web, ingest, scheduler or db, optional KEY=value settings);
#                               `prepare` sets up every other app host: Redis on the VPC, database access, .env, certificate
#
# Hosts: deploy/hosts.tsv lists them, one line each. Exactly one host has the role scheduler (it also holds Redis, the registry
# and runs migrations) and exactly one has db. A release builds once, then prepares and rolls out each app host with its roles:
# the scheduler host first, then the others. A host with the role ingest runs only Horizon's ingest supervisor.
#
# Settings (environment): SCARLET_SECRETS (folder with ops_ed25519, cloudflare-token), DEPLOY_INVENTORY (a hosts file other
# than deploy/hosts.tsv), DEPLOY_HOST and DEPLOY_DB_HOST (one scheduler host and the database host, ignoring the file; the load
# environment sets them), DEPLOY_BUILD_HOST (default medaware; `local` builds on this machine),
# DEPLOY_REPO (default the GitHub repository), DEPLOY_PGBR_NAME (the pgBackRest folder in
# the bucket and the prefix of its passphrase file in the secrets folder; default pgbackrest).
set -euo pipefail

here=$(cd "$(dirname "$0")/.." && pwd)
case "$(uname -s)" in
  MINGW* | MSYS*) default_secrets=E:/Dev/secrets/scarlet-web ;;
  *) default_secrets=$HOME/.config/scarlet-web ;;
esac
secrets=${SCARLET_SECRETS:-$default_secrets}
build_host=${DEPLOY_BUILD_HOST:-medaware}
pgbr_name=${DEPLOY_PGBR_NAME:-pgbackrest}
repo=${DEPLOY_REPO:-https://github.com/Medalink/scarlet-web.git}
cf="node $here/deploy/cloudflare.mjs"
export SCARLET_SECRETS=$secrets

inv_hosts=()
inv_roles=()
inv_settings=()
host=
db_host=

load_inventory() {
  local file=${DEPLOY_INVENTORY:-$here/deploy/hosts.tsv} name roles settings i j word key kv schedulers=() dbs=()
  if [ -z "${DEPLOY_INVENTORY:-}" ] && { [ -n "${DEPLOY_HOST:-}" ] || [ -n "${DEPLOY_DB_HOST:-}" ]; }; then
    inv_hosts=("${DEPLOY_HOST:-scarlet-web}" "${DEPLOY_DB_HOST:-scarlet-db}")
    inv_roles=("web ingest scheduler" db)
    inv_settings=("" "")
  else
    [ -f "$file" ] || { echo "deploy: no inventory at $file" >&2; exit 1; }
    while IFS=$'\t' read -r name roles settings || [ -n "$name" ]; do
      name=${name%$'\r'} roles=${roles%$'\r'} settings=${settings%$'\r'}
      case $name in '' | '#'*) continue ;; esac
      inv_hosts+=("$name")
      inv_roles+=("$roles")
      inv_settings+=("$settings")
    done < "$file"
  fi
  for i in "${!inv_hosts[@]}"; do
    name=${inv_hosts[$i]}
    [[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "deploy: inventory: '$name' is not a host name" >&2; exit 1; }
    for ((j = 0; j < i; j++)); do
      [ "${inv_hosts[$j]}" != "$name" ] || { echo "deploy: inventory: $name is listed twice" >&2; exit 1; }
    done
    [ -n "${inv_roles[$i]}" ] || { echo "deploy: inventory: $name has no roles" >&2; exit 1; }
    for word in ${inv_roles[$i]}; do
      case $word in
        web | ingest) ;;
        scheduler) schedulers+=("$name") ;;
        db) dbs+=("$name") ;;
        *) echo "deploy: inventory: $name has the unknown role '$word' (web, ingest, scheduler, db)" >&2; exit 1 ;;
      esac
    done
    case " ${inv_roles[$i]} " in
      *" db "*) [ "${inv_roles[$i]}" = db ] || { echo "deploy: inventory: $name has the role db and others; the database host does only that" >&2; exit 1; } ;;
    esac
    for kv in ${inv_settings[$i]//,/ }; do
      key=${kv%%=*}
      [[ $key =~ ^[A-Z][A-Z0-9_]*$ && $kv == *=* && ${kv#*=} =~ ^[A-Za-z0-9_.:/@-]*$ ]] || { echo "deploy: inventory: $name: '$kv' is not KEY=value" >&2; exit 1; }
    done
  done
  [ "${#schedulers[@]}" -eq 1 ] || { echo "deploy: inventory: the scheduler runs on exactly one host, found ${#schedulers[@]} (${schedulers[*]:-none})" >&2; exit 1; }
  [ "${#dbs[@]}" -eq 1 ] || { echo "deploy: inventory: exactly one host has the role db, found ${#dbs[@]} (${dbs[*]:-none})" >&2; exit 1; }
  host=${schedulers[0]}
  db_host=${dbs[0]}
}
load_inventory

index_of() {
  local i
  for i in "${!inv_hosts[@]}"; do
    if [ "${inv_hosts[$i]}" = "$1" ]; then echo "$i"; return; fi
  done
  echo "deploy: $1 is not in the inventory" >&2
  exit 1
}
roles_of() { echo "${inv_roles[$(index_of "$1")]}"; }
settings_of() { echo "${inv_settings[$(index_of "$1")]}"; }
has_role() { case " $(roles_of "$1") " in *" $2 "*) return 0 ;; esac; return 1; }
other_app_hosts() {
  local h
  for h in "${inv_hosts[@]}"; do
    [ "$h" = "$host" ] || [ "$h" = "$db_host" ] || echo "$h"
  done
}

ssh_opts=(-i "$secrets/ops_ed25519" -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30)
at() {
  local target=$1
  shift
  ssh "${ssh_opts[@]}" "ops@$target" "$@"
}
srv() { at "$host" "$@"; }
dsrv() { at "$db_host" "$@"; }
roll_at() {
  local target=$1
  shift
  at "$target" "SCARLET_ROLES='$(roles_of "$target")' /srv/scarlet-web/deploy/rollout.sh $*"
}
on_build() {
  if [ "$build_host" = local ]; then bash -c "$1"; else ssh -o ServerAliveInterval=30 "$build_host" "$1"; fi
}
# Where the build host keeps its clone: the same place build.sh uses.
build_src='$(echo /data/$(id -un))/scratch/scarlet-web-build/src'

push_deploy_folder() {
  local t0 target=${1:-$host}
  t0=$(now)
  on_build "tar -C $build_src -cf - deploy" | at "$target" 'rm -rf /srv/scarlet-web/deploy.new && mkdir -p /srv/scarlet-web/deploy.new && tar -C /srv/scarlet-web/deploy.new --strip-components=1 --no-same-owner -xf - && rm -rf /srv/scarlet-web/deploy && mv /srv/scarlet-web/deploy.new /srv/scarlet-web/deploy'
  [ "$target" = "$host" ] || return 0
  echo "phase deploy-folder $(span "$t0" "$(now)")" >> "$timing/ship.out"
}

now() { date +%s.%N; }
span() { awk -v a="$1" -v b="$2" 'BEGIN { printf "%.1f", b - a }'; }

timing=
lap_at=
laps=()
lap() {
  local t
  t=$(now)
  laps+=("$1|$(span "$lap_at" "$t")")
  lap_at=$t
}
phase_of() { sed -n "s/^phase $2 //p" "$timing/$1" 2>/dev/null | tail -n 1; }
row() { printf '  %-26s %8s s\n' "$1" "${2:-n/a}"; }
report() {
  [ -n "$timing" ] || return 0
  local l name secs
  echo "deploy: time per phase"
  for l in "${laps[@]}"; do
    name=${l%%|*}
    secs=${l##*|}
    row "$name" "$secs"
    case $name in
      build)
        row "  slot wait" "$(phase_of build.out slot-wait)"
        row "  docker build" "$(phase_of build.out docker-build)"
        ;;
      "image transfer")
        row "  wait for the tunnel" "$(phase_of ship.out tunnel-wait)"
        row "  docker push" "$(phase_of ship.out push)"
        row "  deploy folder (alongside)" "$(phase_of ship.out deploy-folder)"
        ;;
      rollout)
        row "  pull and start databases" "$(phase_of rollout.out compose-up)"
        row "  migrate" "$(phase_of rollout.out migrate)"
        row "  start and health check" "$(phase_of rollout.out start-health)"
        row "  switch" "$(phase_of rollout.out switch)"
        row "    assets, nginx" "$(phase_of rollout.out switch-nginx)"
        row "    stop old php-fpm" "$(phase_of rollout.out stop-old-app)"
        row "    horizon, schedule" "$(phase_of rollout.out start-workers)"
        row "  prune images" "$(phase_of rollout.out prune)"
        ;;
    esac
  done
  row total "$(span "$deploy_at" "$(now)")"
  [ ! -s "$timing/sent_kb" ] || printf '  new layers stored on the droplet: %s MB\n' "$(awk '{ printf "%.1f", $1 / 1024 }' "$timing/sent_kb")"
  rm -rf "$timing"
}

build() {
  local ref=$1
  on_build "bash -s -- '$repo' '$ref'" < "$here/deploy/build.sh" | tee /dev/stderr | tee "$timing/build.out" | sed -n 's/^built //p' | tail -n 1
}

ship_whole_image() {
  local tag=$1
  { on_build "sudo -n docker save scarlet-web-app:$tag | zstd -T2 -3"; now > "$timing/sent"; } | srv 'zstd -d | docker load'
}

registry_port=5077
tunnel_port=15077
registry_url=127.0.0.1:$registry_port
registry_data_kb='docker exec scarlet-web-registry-1 du -sk /var/lib/registry | cut -f1'

open_registry_path() {
  local kb
  kb=$(srv "curl -sf -o /dev/null http://127.0.0.1:$registry_port/v2/ || /srv/scarlet-web/deploy/dc up -d --no-deps --wait registry >&2; $registry_data_kb") || return 1
  echo "$kb" > "$timing/before_kb"
  exec ssh "${ssh_opts[@]}" -o ExitOnForwardFailure=yes -N -L "127.0.0.1:$tunnel_port:127.0.0.1:$registry_port" "ops@$host"
}

registry_job=
ship_new_layers() {
  local tag=$1 after ready= rc=0 at=$registry_url t0 t1
  t0=$(now)
  for _ in $(seq 1 150); do
    if [ -s "$timing/before_kb" ] && curl -sf --max-time 2 -o /dev/null "http://127.0.0.1:$tunnel_port/v2/"; then ready=1; break; fi
    kill -0 "$registry_job" 2>/dev/null || break
    sleep 0.1
  done
  [ -n "$ready" ] || return 1
  t1=$(now)
  echo "phase tunnel-wait $(span "$t0" "$t1")" >> "$timing/ship.out"
  [ "$build_host" = local ] && at=127.0.0.1:$tunnel_port
  local push="sudo -n docker tag scarlet-web-app:$tag $at/scarlet-web-app:$tag && sudo -n docker push -q $at/scarlet-web-app:$tag >/dev/null; rc=$?; sudo -n docker rmi $at/scarlet-web-app:$tag >/dev/null 2>&1; echo pushed:$rc"
  local pusher
  if [ "$build_host" = local ]; then
    bash -c "$push" > "$timing/push.out" &
  else
    ssh -o ServerAliveInterval=30 -o ExitOnForwardFailure=yes -R "127.0.0.1:$registry_port:127.0.0.1:$tunnel_port" "$build_host" "$push" > "$timing/push.out" &
  fi
  pusher=$!
  until grep -q '^pushed:' "$timing/push.out" 2>/dev/null || ! kill -0 "$pusher" 2>/dev/null; do sleep 0.1; done
  grep -qx 'pushed:0' "$timing/push.out" 2>/dev/null || rc=1
  kill "$pusher" "$registry_job" 2>/dev/null || true
  [ "$rc" = 0 ] || return 1
  now > "$timing/sent"
  echo "phase push $(span "$t1" "$(cat "$timing/sent")")" >> "$timing/ship.out"
  after=$(srv "docker pull -q $registry_url/scarlet-web-app:$tag >/dev/null && docker tag $registry_url/scarlet-web-app:$tag scarlet-web-app:$tag && docker rmi $registry_url/scarlet-web-app:$tag >/dev/null && $registry_data_kb") || return 1
  echo $((after - $(cat "$timing/before_kb"))) > "$timing/sent_kb"
}

ship_images() {
  local tag=$1
  if [ "${DEPLOY_TRANSPORT:-registry}" = registry ] && ship_new_layers "$tag"; then return 0; fi
  echo "deploy: sending the whole image"
  ship_whole_image "$tag"
}

private_address_of() { at "$1" 'curl -fsS http://169.254.169.254/metadata/v1/interfaces/private/0/ipv4/address'; }

app_private_addresses() {
  local h out
  out=$(app_private_address)
  for h in $(other_app_hosts); do out="$out $(private_address_of "$h")"; done
  echo "$out"
}

ship_image_to() {
  local target=$1 tag=$2 job rc=1 local_port=$((tunnel_port + 1))
  if at "$target" "docker image inspect scarlet-web-app:$tag >/dev/null 2>&1"; then return 0; fi
  if [ "${DEPLOY_TRANSPORT:-registry}" = registry ]; then
    ssh "${ssh_opts[@]}" -o ExitOnForwardFailure=yes -N -L "127.0.0.1:$local_port:127.0.0.1:$registry_port" "ops@$host" &
    job=$!
    for _ in $(seq 1 50); do
      curl -sf --max-time 2 -o /dev/null "http://127.0.0.1:$local_port/v2/" && break
      sleep 0.2
    done
    ssh "${ssh_opts[@]}" -o ExitOnForwardFailure=yes -R "127.0.0.1:$registry_port:127.0.0.1:$local_port" "ops@$target" \
      "docker pull -q $registry_url/scarlet-web-app:$tag >/dev/null && docker tag $registry_url/scarlet-web-app:$tag scarlet-web-app:$tag && docker rmi $registry_url/scarlet-web-app:$tag >/dev/null" && rc=0
    kill "$job" 2>/dev/null || true
  fi
  if [ "$rc" != 0 ]; then
    echo "deploy: sending the whole image to $target"
    srv "docker save scarlet-web-app:$tag | zstd -T2 -3" | at "$target" 'zstd -d | docker load'
  fi
}

# What a second app host needs before its first rollout, each step safe to run again: the database lets its VPC address in,
# Redis on the scheduler host listens on the VPC (firewall first), and the host gets the stack's .env with Redis pointed at
# the scheduler host plus its own settings, the database certificate and, for the web role, the origin certificate.
prepare_host() {
  local target=$1 paddr addr all roles marker have kv
  roles=$(roles_of "$target")
  db_moved || { echo "deploy: $target needs the database on $db_host: run bin/deploy db-move first" >&2; exit 1; }
  paddr=$(app_private_address)
  addr=$(private_address_of "$target")
  all=$(app_private_addresses)
  marker="$paddr $addr $roles | $all"
  have=$(at "$target" 'cat /srv/scarlet-web/state/host-ready 2>/dev/null' || true)
  if [ "$have" != "$marker" ]; then
    echo "deploy: preparing $target ($roles)"
    node "$here/deploy/provision.mjs" redis --droplet "$host"
    srv "cd /srv/scarlet-web && mkdir -p state && if [ \"\$(cat state/redis-vpc.env 2>/dev/null)\" != 'REDIS_VPC_ADDRESS=$paddr' ]; then echo 'REDIS_VPC_ADDRESS=$paddr' > state/redis-vpc.env && deploy/dc up -d --wait redis redis-cache; fi"
    tar -C "$here" -cf - deploy/db-hba.sh | dsrv 'tar -C /srv/scarlet-db --no-same-owner -xf -'
    dsrv "sudo sh /srv/scarlet-db/deploy/db-hba.sh $all"
    at "$target" 'sudo install -d -o ops -g ops -m 750 /srv/scarlet-web /srv/scarlet-web/state /srv/scarlet-web/dbtls'
    tar -C "$here" -cf - deploy | at "$target" 'tar -C /srv/scarlet-web --no-same-owner -xf -'
    srv 'cat /srv/scarlet-web/dbtls/db-ca.crt' | at "$target" 'cat > /srv/scarlet-web/dbtls/db-ca.crt && chmod 644 /srv/scarlet-web/dbtls/db-ca.crt'
    if has_role "$target" web; then
      srv 'tar -C /srv/scarlet-web -cf - tls' | at "$target" 'tar -C /srv/scarlet-web --no-same-owner -xf - && chmod 600 /srv/scarlet-web/tls/origin.key && install -d -m 755 /srv/scarlet-web/maps'
    fi
  fi
  {
    srv 'grep -vE "^(REDIS_HOST|REDIS_PORT|REDIS_CACHE_HOST|REDIS_CACHE_PORT|SCARLET_[A-Z_]*PROCESSES)=" /srv/scarlet-web/.env'
    printf 'REDIS_HOST=%s\nREDIS_PORT=6379\nREDIS_CACHE_HOST=%s\nREDIS_CACHE_PORT=6380\n' "$paddr" "$paddr"
    for kv in $(settings_of "$target" | tr ',' ' '); do printf '%s\n' "$kv"; done
  } | at "$target" 'umask 077 && cat > /srv/scarlet-web/.env.new && mv /srv/scarlet-web/.env.new /srv/scarlet-web/.env && touch /srv/scarlet-web/release.env && chmod 755 /srv/scarlet-web/dbtls'
  at "$target" "echo '$marker' > /srv/scarlet-web/state/host-ready"
}

apply_settings() {
  local target=$1 kv
  for kv in $(settings_of "$target" | tr ',' ' '); do
    at "$target" "cd /srv/scarlet-web && grep -v '^${kv%%=*}=' .env > .env.new; echo '$kv' >> .env.new; chmod 600 .env.new; mv .env.new .env"
  done
}

# One deploy at a time, build included: every deploy builds in the same clone on the build host and unpacks into the
# same folders on the server. The lock is a folder on the server; one older than 40 minutes is a crashed deploy's.
lock=/srv/scarlet-web/state/deploy.lock
take_lock() {
  until srv "mkdir -p /srv/scarlet-web/state && mkdir $lock 2>/dev/null && date +%s > $lock/at"; do
    srv "[ -f $lock/at ] && [ \$(( \$(date +%s) - \$(cat $lock/at) )) -gt 2400 ] && rm -rf $lock" || true
    echo "deploy: another deploy is running; waiting for it"
    sleep 3
  done
  trap 'srv "rm -rf '"$lock"'"; kill "$registry_job" 2>/dev/null || true; report' EXIT
}

release() {
  local ref=${1:-main} sha
  timing=$(mktemp -d)
  deploy_at=$(now)
  lap_at=$deploy_at
  take_lock
  lap "lock wait"
  if [ "${DEPLOY_TRANSPORT:-registry}" = registry ]; then
    open_registry_path &
    registry_job=$!
  fi
  sha=$(build "$ref")
  [ -n "$sha" ] || { echo "deploy: the build gave no sha" >&2; exit 1; }
  echo "deploy: built $sha"
  lap build
  push_deploy_folder &
  local folder_job=$!
  ship_images "${sha:0:12}"
  wait "$folder_job"
  local end other
  end=$(now)
  laps+=("image transfer|$(span "$lap_at" "$(cat "$timing/sent")")" "load or pull on droplet|$(span "$(cat "$timing/sent")" "$end")")
  lap_at=$end
  for other in $(other_app_hosts); do
    prepare_host "$other"
    push_deploy_folder "$other"
    ship_image_to "$other" "${sha:0:12}"
  done
  apply_settings "$host"
  roll_at "$host" "${sha:0:12}" 2>&1 | tee "$timing/rollout.out"
  lap rollout
  for other in $(other_app_hosts); do
    echo "deploy: rolling out on $other ($(roles_of "$other"))"
    roll_at "$other" "${sha:0:12}" 2>&1 | tee "$timing/rollout-$other.out"
  done
  echo "deploy: $sha is live"
}

step_server() {
  srv 'sudo install -d -o ops -g ops -m 750 /srv/scarlet-web'
  # The first deploy folder comes from the checkout this script runs in; later releases bring their own.
  tar -C "$here" -cf - deploy | srv 'tar -C /srv/scarlet-web --no-same-owner -xf -'
  srv 'sh /srv/scarlet-web/deploy/server-setup.sh'
}

step_tls() {
  local tmp
  tmp=$(mktemp -d)
  srv 'cat /srv/scarlet-web/tls/origin.csr' > "$tmp/origin.csr"
  $cf origin-cert "$tmp/origin.csr" "$tmp/origin.pem"
  srv 'cat > /srv/scarlet-web/tls/origin.pem && chmod 644 /srv/scarlet-web/tls/origin.pem' < "$tmp/origin.pem"
  rm -rf "$tmp"
}

# The ring's key goes in authorized_keys2, a file of its own, so the ops key's line is never rewritten. sshd must read
# that file (its default does); when it does not, nothing is changed.
step_ring_key() {
  local pub
  pub=$(tr -d '\r\n' < "$1")
  case $pub in
    ssh-ed25519\ *) ;;
    *) echo "deploy: $1 does not hold an ssh-ed25519 public key" >&2; exit 1 ;;
  esac
  srv 'sudo sshd -T | grep -i "^authorizedkeysfile" | grep -q "authorized_keys2"' || { echo "deploy: sshd on $host does not read ~/.ssh/authorized_keys2; nothing changed" >&2; exit 1; }
  srv 'sudo install -o root -g root -m 755 /dev/stdin /usr/local/sbin/scarlet-deploy-entry' < "$here/scripts/deploy/ring-entry.sh"
  printf 'restrict,port-forwarding,permitopen="127.0.0.1:%s",command="/usr/local/sbin/scarlet-deploy-entry" %s\n' "$registry_port" "$pub" \
    | srv 'umask 077 && cat > ~/.ssh/authorized_keys2.new && mv ~/.ssh/authorized_keys2.new ~/.ssh/authorized_keys2'
  echo "deploy: the ring key may now run /usr/local/sbin/scarlet-deploy-entry on $host and nothing else"
}

droplet_address() { srv "ip -$1 route get $2 | grep -o 'src [^ ]*' | cut -d' ' -f2"; }

step_dns() {
  $cf dns "$(droplet_address 4 1.1.1.1)" "$(droplet_address 6 2606:4700:4700::1111)"
  $cf settings
}

step_aop() {
  $cf aop on
  srv 'cp /srv/scarlet-web/deploy/nginx/aop-on.conf /srv/scarlet-web/state/aop.conf && /srv/scarlet-web/deploy/dc exec -T web nginx -c /etc/nginx/scarlet/nginx.conf -t && /srv/scarlet-web/deploy/dc exec -T web nginx -c /etc/nginx/scarlet/nginx.conf -s reload'
}

# The R2 credentials go from the secrets folder to /etc/scarlet-web/r2.env (root:root, mode 600) as rclone settings.
# The values are read inside this command and pass through the ssh pipe only: no argument, log or file here holds them.
step_r2() {
  local f run=${1:-srv}
  for f in r2-access-key-id r2-secret-access-key r2-endpoint; do
    [ -s "$secrets/$f" ] || { echo "deploy: $secrets/$f is missing" >&2; exit 1; }
  done
  $run 'sudo install -d -m 755 /etc/scarlet-web'
  {
    printf 'RCLONE_CONFIG_R2_TYPE=s3\nRCLONE_CONFIG_R2_PROVIDER=Cloudflare\n'
    printf 'R2_BUCKET=%s\n' "${R2_BUCKET:-scarlet-web-backups}"
    [ -z "${R2_PREFIX:-}" ] || printf 'R2_PREFIX=%s\n' "$R2_PREFIX"
    printf 'RCLONE_CONFIG_R2_ACCESS_KEY_ID=%s\n' "$(tr -d '\r\n' < "$secrets/r2-access-key-id")"
    printf 'RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=%s\n' "$(tr -d '\r\n' < "$secrets/r2-secret-access-key")"
    printf 'RCLONE_CONFIG_R2_ENDPOINT=%s\n' "$(tr -d '\r\n' < "$secrets/r2-endpoint")"
  } | $run 'sudo sh -c "umask 077 && cat > /etc/scarlet-web/r2.env.new && chown root:root /etc/scarlet-web/r2.env.new && mv /etc/scarlet-web/r2.env.new /etc/scarlet-web/r2.env"'
  echo "deploy: wrote /etc/scarlet-web/r2.env on $([ "$run" = srv ] && echo the app droplet || echo the database host) (root:root, mode 600)"
}

# The nightly unit's last result, then the newest local and R2 copies with their ages. Exits 1 when the last run
# failed, R2 cannot be read or its newest daily copy is more than 26 hours old. The unit runs where the database is; with the
# database on its own host the report adds the WAL archive: it also fails when the last archived segment is older than 5
# minutes, when the archiver's last attempt failed or when pgBackRest has no backup (deploy/db-host.sh status).
backups_report() {
  local result rc=0 run=srv base=/srv/scarlet-web
  if db_moved; then run=dsrv base=/srv/scarlet-db; fi
  result=$($run 'systemctl show -p Result --value scarlet-backup.service')
  echo "backup unit on $([ "$run" = srv ] && echo "$host" || echo "$db_host"): last result $result; $($run 'systemctl list-timers scarlet-backup.timer --no-pager | sed -n 2p' | awk '{print "next run", $1, $2, $3}')"
  [ "$result" = success ] || rc=1
  $run "sudo sh -c \"set -a; . /etc/scarlet-web/r2.env; set +a; export SCARLET_BASE=$base; exec $base/deploy/backup.sh status\"" || rc=1
  if [ "$run" = dsrv ]; then dsrv /srv/scarlet-db/deploy/db-host.sh status || rc=1; fi
  return "$rc"
}

. "$here/deploy/db-move.sh"

case "${1:-release}" in
  release) release "${2:-main}" ;;
  rollback)
    take_lock
    roll_at "$host" --rollback
    for other in $(other_app_hosts); do
      echo "deploy: rolling $other back"
      roll_at "$other" --rollback || echo "deploy: $other has no earlier release; it stays on its current one"
    done
    ;;
  hosts)
    case "${2:-list}" in
      list)
        for i in "${!inv_hosts[@]}"; do
          printf '%-24s %-26s %s\n' "${inv_hosts[$i]}" "${inv_roles[$i]}" "${inv_settings[$i]}"
        done
        ;;
      prepare)
        take_lock
        for other in $(other_app_hosts); do prepare_host "$other"; done
        ;;
      *) echo "deploy: hosts [list|prepare]" >&2; exit 2 ;;
    esac
    ;;
  status)
    srv '/srv/scarlet-web/deploy/dc ps; cat /srv/scarlet-web/release.env'
    for other in $(other_app_hosts); do
      echo "== $other ($(roles_of "$other"))"
      at "$other" '/srv/scarlet-web/deploy/dc ps; cat /srv/scarlet-web/release.env'
    done
    $cf status
    db_moved && db_status
    backups_report
    ;;
  logs) at "${3:-$host}" "/srv/scarlet-web/deploy/dc logs --tail 100 -f ${2:-}" ;;
  backup)
    run=srv
    ! db_moved || run=dsrv
    $run 'sudo systemctl start scarlet-backup.service; rc=$?; journalctl -u scarlet-backup.service -n 12 --no-pager -o cat; exit $rc'
    ;;
  backups) backups_report ;;
  r2)
    step_r2 srv
    ! db_moved || step_r2 dsrv
    ;;
  db-server) db_lock; db_server ;;
  db-move)
    case "${2:-move}" in
      move) db_move ;;
      rollback) db_rollback ;;
      abort) db_lock; db_abort_manual ;;
      retire) db_lock; db_retire ;;
      finish) db_lock; db_finish "$(db_private_address)" ;;
      *) echo "deploy: db-move [rollback|abort|retire|finish]" >&2; exit 2 ;;
    esac
    ;;
  db)
    case "${2:-status}" in
      status) db_status ;;
      upgrade) db_lock; db_upgrade ;;
      *) echo "deploy: db [status|upgrade]" >&2; exit 2 ;;
    esac
    ;;
  maps)
    [ -f "${2:?folder with manifest.json}/manifest.json" ] || { echo "deploy: no manifest.json in $2" >&2; exit 1; }
    for target in $(printf '%s\n' "$host" $(other_app_hosts) | sort -u); do
      has_role "$target" web || continue
      tar -C "$2" -cf - . | at "$target" 'mkdir -p /srv/scarlet-web/maps && tar -C /srv/scarlet-web/maps --no-same-owner -xf - && chmod -R a+rX /srv/scarlet-web/maps'
      echo "deploy: maps copied to /srv/scarlet-web/maps on $target"
    done
    ;;
  server) step_server ;;
  tls) step_tls ;;
  dns) step_dns ;;
  strict) $cf ssl strict ;;
  cache-rules) $cf cache-rules ;;
  aop) step_aop ;;
  bootstrap)
    step_server
    step_dns
    step_tls
    release "${2:-main}"
    srv "curl -sk --resolve scarletweb.io:443:127.0.0.1 -o /dev/null -w 'origin certificate serves: %{http_code}\n' https://scarletweb.io/up"
    curl -s -o /dev/null -w 'through Cloudflare (ssl full): %{http_code}\n' https://scarletweb.io/up
    $cf ssl strict
    sleep 5
    curl -s -o /dev/null -w 'through Cloudflare (ssl strict): %{http_code}\n' https://scarletweb.io/up
    step_aop
    sleep 5
    curl -s -o /dev/null -w 'through Cloudflare (origin pulls): %{http_code}\n' https://scarletweb.io/up
    ;;
  ring-key) step_ring_key "${2:?the file with the public key of the ring}" ;;
  ssh) shift; srv "$@" ;;
  help | -h | --help) sed -n '2,26p' "$0" ;;
  *) release "$1" ;;
esac
