#!/bin/sh
# Starts and stops the local containers: bin/dev up, bin/dev bootstrap, bin/dev start, bin/dev status ...
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
if command -v pwsh >/dev/null 2>&1; then shell=pwsh; else shell=powershell; fi
exec "$shell" -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$root/scripts/wslc/dev.ps1")" "$@"
