{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "medalink/scarlet-web",
    "type": "project",
    "description": "The API the Scarlet app uploads to, and the web app that shows what players choose to share.",
    "keywords": [
        "laravel",
        "scarlet"
    ],
    "license": "GPL-3.0-only",
    "require": {
        "php": "^8.5",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "ext-sodium": "*",
        "laravel/framework": "13.42.0",
        "laravel/horizon": "5.51.0",
        "laravel/sanctum": "4.5.0",
        "laravel/socialite": "5.33.0",
        "laravel/tinker": "3.2.0",
        "livewire/livewire": "4.4.8",
        "medalink/laravel-app-version": "0.1.23",
        "socialiteproviders/battlenet": "4.1.1"
    },
    "require-dev": {
        "larastan/larastan": "3.15.0",
        "laravel/pint": "1.32.3"
    },
    "conflict": {
        "firebase/php-jwt": ">=7.2.2",
        "guzzlehttp/guzzle": ">=8.5.1",
        "guzzlehttp/promises": ">=3.1.1",
        "guzzlehttp/psr7": ">=3.5.0",
        "monolog/monolog": ">=3.13.0",
        "paragonie/constant_time_encoding": ">=3.1.5",
        "phpseclib/phpseclib": ">=4.0.4",
        "phpstan/phpstan": ">=2.3.6",
        "ramsey/uuid": ">=4.10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scarlet\\Analysis\\": "tools/Analysis/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "pnpm install --frozen-lockfile",
            "pnpm run build"
        ],
        "lint": "pint",
        "lint:check": "pint --test",
        "analyse": "@php -d opcache.enable_cli=0 scripts/dev/analyse.php",
        "guidance": "@php scripts/dev/guidance.php",
        "deps:age": "@php scripts/deps-age",
        "check": [
            "@lint:check",
            "@analyse",
            "@deps:age"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "process-timeout": 0,
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "abandoned": {
                "block": true,
                "audit": "fail"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            },
            "ignore-unreachable": false
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [{
        "name": "laravel-app-version",
        "type": "vcs",
        "url": "https://github.com/Medalink/laravel-app-version",
        "no-api": true
    }]
}
