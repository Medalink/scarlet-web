APP_NAME=Scarlet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8470

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 with TimescaleDB, the only database. The names below are the wslc containers
# of bin/dev; bin/dev bootstrap sets DB_DATABASE to scarlet_web_wt_<checkout folder>.
DB_CONNECTION=pgsql
DB_HOST=scarlet-web-pg
DB_PORT=5432
DB_DATABASE=scarlet
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=scarlet-web-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=scarlet_
CACHE_PREFIX=scarlet_cache_

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=scarlet_session

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
HORIZON_PREFIX=scarlet_horizon:

# Pages hide a bucket that fewer characters than this contributed to: 5 on a public deploy.
SCARLET_MIN_CHARACTERS=1
# The scarlet-part binary the queue job runs. The default is part/target/release/scarlet-part.
SCARLET_PART_BIN=

# Sign-in. Create the OAuth clients with each provider; the redirect URI is
# APP_URL/login/google/callback and APP_URL/login/battlenet/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
# us, eu, kr, tw or cn
BATTLENET_REGION=us

VITE_APP_NAME="${APP_NAME}"
