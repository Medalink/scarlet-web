APP_NAME=Scarlet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8470

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 with TimescaleDB, the only database. The names below are the wslc containers
# of bin/dev; bin/dev bootstrap sets DB_DATABASE to scarlet_web_wt_<checkout folder>.
DB_CONNECTION=pgsql
DB_HOST=scarlet-web-pg
DB_PORT=5432
DB_DATABASE=scarlet
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=scarlet-web-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=scarlet_
CACHE_PREFIX=scarlet_cache_

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=scarlet_session

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
HORIZON_PREFIX=scarlet_horizon:

# Pages hide a bucket that fewer characters than this contributed to: 5 on a public deploy.
SCARLET_MIN_CHARACTERS=1
# The scarlet-part binary the API and the queue run: the dev image has it at this path.
SCARLET_PART_BIN=/usr/local/bin/scarlet-part

# Sign-in. Create the OAuth clients with each provider; the redirect URI is
# APP_URL/auth/google/callback and APP_URL/auth/battlenet/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
# us, eu, kr, tw or cn
BATTLENET_REGION=us
# A "Development sign-in" button on /login. Works only when APP_ENV=local.
SCARLET_DEV_LOGIN=false

VITE_APP_NAME="${APP_NAME}"

# Compiled views on the container's own disk. On the bind-mounted checkout every view check costs about 2 ms, which made a page take 90 ms longer.
VIEW_COMPILED_PATH=/tmp/scarlet-views
